{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "esModuleInterop": true,
    "target": "ES2020"
  },
  "include": ["src/**/*"],
  "exclude": ["test", "node_modules", "dist"]
}
